{
  "name": "@mail-agent/desktop",
  "version": "0.1.0-beta.1",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:runtime": "node scripts/prepare-assets.mjs --skip-model",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs",
    "package:win": "npm run build && electron-builder --config electron-builder.config.cjs --win zip",
    "package:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac dmg zip"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "43.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2"
  }
}
